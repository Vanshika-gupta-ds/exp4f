
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="Learn web development, HTML, CSS, SEO optimization and website accessibility.">

    <meta name="keywords"
        content="HTML, CSS, SEO, Web Development, Accessibility">

    <meta name="author" content="Web Development Student">

    <title>Web Development | SEO and Accessibility</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>Welcome to Web Development</h1>

        <nav aria-label="Main Navigation">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#services">Services</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <main>

        <section id="home">
            <h2>Home</h2>
            <p>
                Welcome to our website. Explore the world of
                web development and learn modern web technologies.
            </p>

            <img src="web-development.jpg"
                alt="Web development using HTML, CSS and JavaScript">
        </section>

        <section id="about">
            <h2>About Us</h2>
            <p>
                We provide information about website development,
                web design and search engine optimization.
            </p>
        </section>

        <section id="services">
            <h2>Our Services</h2>

            <article>
                <h3>Web Design</h3>
                <p>Creating attractive and responsive websites.</p>
            </article>

            <article>
                <h3>SEO Optimization</h3>
                <p>Improving website visibility on search engines.</p>
            </article>

            <article>
                <h3>Accessibility</h3>
                <p>Making websites accessible to everyone.</p>
            </article>
        </section>

        <section id="contact">
            <h2>Contact Us</h2>
            <p>Email: example@email.com</p>
        </section>

    </main>

    <footer>
        <p>&copy; 2026 Web Development. All rights reserved.</p>
    </footer>

</body>
</html>
